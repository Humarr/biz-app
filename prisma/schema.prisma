generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model VisitorSession {
  id            String   @id @default(cuid())
  ipAddress     String?
  userAgent     String?
  device        String?       // ← NEW
  country       String?       // ← NEW
  city          String?       // ← NEW
  enteredAt     DateTime @default(now())
  leftAt        DateTime?
  clickedPayAt  DateTime?
  pathname      String?
  userData      UserData?
  payment       Payment?
  downloadLogs  DownloadLog[]
  pageViews     PageView[]
}

model UserData {
  id             String   @id @default(cuid())
  sessionId      String   @unique
  name           String
  email          String
  phone          String
  createdAt      DateTime @default(now())
  visitorSession VisitorSession @relation(fields: [sessionId], references: [id])
}

model Payment {
  id             String   @id @default(cuid())
  sessionId      String   @unique
  paystackRef    String   @unique
  amount         Int
  status         String
  paidAt         DateTime
  visitorSession VisitorSession @relation(fields: [sessionId], references: [id])
}

model DownloadLog {
  id             String   @id @default(cuid())
  sessionId      String
  downloadedAt   DateTime @default(now())
  ipAddress      String?
  visitorSession VisitorSession @relation(fields: [sessionId], references: [id])
}



model PageView {
  id           String   @id @default(cuid())
  sessionId    String
  path         String
  viewedAt     DateTime @default(now())
  leftAt       DateTime?
  visitorSession VisitorSession @relation(fields: [sessionId], references: [id])
}
